rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /training_uploads/{userId}/{allPaths=**} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /models/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}

